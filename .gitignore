node_modules
dist
.npm-cache
*.tsbuildinfo

# E2E (M8): generated fixtures and run artifacts (report + logs)
/e2e/.fixtures/
/e2e/artifacts/
logs/

# Lighthouse harness (M32): the preview build, its temp WAV/analysis dump, and the
# generated report. The committed surface/fixture sources live under `src/preview/`.
/.lighthouse/
/reports/lighthouse/

# ts-rs's fallback export dir: `cargo test` run outside `src-tauri/` misses
# `src-tauri/.cargo/config.toml` and writes here instead of `src/bindings/`.
/src-tauri/bindings/

# husky v9 keeps its generated hook shims here; the hooks themselves
# (.husky/pre-commit, .husky/pre-push) are tracked.
.husky/_/
