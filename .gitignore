node_modules
dist
.npm-cache
*.tsbuildinfo

# Landing (Astro): build output, generated content-layer types, and screenshots
# copied from docs/manual by landing/scripts/sync-assets.mjs.
/landing/dist/
/landing/help-dist/
/landing/.astro/
/landing/public/manual-assets/

# In-app manual: the Astro docs build copied into the app bundle by
# landing/scripts/build-help.mjs (Vite serves it in dev and copies it into dist/).
/public/help/

# E2E (M8): generated fixtures and run artifacts (report + logs)
/e2e/.fixtures/
/e2e/artifacts/
logs/

# Lighthouse harness (M32): the preview build, its temp WAV/analysis dump, and the
# generated report. The committed surface/fixture sources live under `src/preview/`.
/.lighthouse/
/reports/lighthouse/

# ts-rs's fallback export dir. The repo-root `.cargo/config.toml` points the export
# at `src/bindings/`; this entry is only a safety net for a run that bypasses it.
/src-tauri/bindings/

# The `hey-listen-cli` sidecar copy staged by `npm run sidecar` for
# `bundle.externalBin` (a build artifact, never committed).
/src-tauri/binaries/

# husky v9 keeps its generated hook shims here; the hooks themselves
# (.husky/pre-commit, .husky/pre-push) are tracked.
.husky/_/
.gh-cache/
*.tmp
