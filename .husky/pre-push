# Pre-push gate: the whole maid. Repo-scoped and slower than the pre-commit hook, so
# it runs once per push rather than once per commit. CI runs the same command.
npm run maid

# core.hooksPath points at husky, so git-lfs's own hook never installs. Forward the
# refs on stdin to it, or LFS objects stay local and clones check out pointers.
git lfs pre-push "$@"
