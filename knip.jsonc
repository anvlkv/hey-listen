{
  // ---------------------------------------------------------------------------
  // Dead-code gate — "the maid", phase 1. `npx knip` is the check this file owns.
  //
  // Goal: turn `npx knip` into a trustworthy, exit-0 gate. This config (1) teaches
  // knip the real entry-point chain so the app, the E2E suite and the repo scripts
  // are not mistaken for dead code, (2) names the generated/vendored trees that are
  // never dead-code findings, and (3) declares truly-dead code (the `ignoreIssues`
  // worklist) — now empty, since the dead-code-removal phase deleted every entry.
  //
  // `npx knip` prints a few "Configuration hints" (mostly "Remove from ignore")
  // and still exits 0: hints are knip's advice, not findings. See the `ignore`
  // block for why those entries are kept on purpose.
  // ---------------------------------------------------------------------------
  "$schema": "./node_modules/knip/schema-jsonc.json",

  // --- Entry points ----------------------------------------------------------
  // Knip resolves the app through `index.html` → `src/index.tsx` (its Vite plugin
  // reads the script tag) and auto-detects the root configs (`vite.config.ts`,
  // `wdio.conf.ts`) and the files package.json / CI run (`scripts/*.mjs`,
  // `scripts/*.test.ts`). What it could not infer is the E2E suite — `wdio` drives
  // `e2e/**` and imports nothing from the app — so every spec, every `e2e/support`
  // module and the screenshots config were reported as *unused files*. These are
  // the real roots for that suite; the app and scripts need no listing.
  "entry": [
    // Vite entry (the plugin then picks up `src/index.tsx`).
    "index.html",

    // E2E suite: each spec is a root; `e2e/support/**` is reached via imports.
    "e2e/specs/**/*.spec.ts",
    "e2e/screenshots/**/*.spec.ts",
    "screenshots.wdio.conf.ts",
  ],

  // The files knip may analyse: the app, the suite, the repo scripts and the root
  // configs (`*.ts` covers `vite.config.ts` + the two `*.wdio.conf.ts`).
  // `eslint.config.js` is picked up by knip's own ESLint-plugin detection, so its
  // deps stay "used" without listing it here.
  "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "scripts/**/*.{ts,mjs}", "*.ts"],

  // --- Generated / vendored trees (never dead-code findings) ------------------
  // Only `src/bindings/**` needs listing: it is ts-rs output rewritten by
  // `cargo test`, but it is *committed*, so knip cannot exclude it via .gitignore
  // (unlike `dist/`, `site/`, `public/`, `src-tauri/target/`, `src-tauri/gen/` and
  // `e2e/artifacts/`, which are git-ignored build output and already outside the
  // `project` globs below).
  "ignore": ["src/bindings/**"],

  // Solid components and state modules export a value/type that is often only
  // read in the same file (a signal's `setX` used by the module's own actions, a
  // `Props` type used once). That is not dead code — and it is exactly what made
  // the first report look "suspiciously broad": `setDirty`, `TOOLS`, `allThemes`,
  // `setPreviewPlaying`, `NODE_KINDS`, `focusedTool`, `windowLabel`, … are all
  // used in their own file.
  "ignoreExportsUsedInFile": true,

  // --- Dependencies / binaries that are real but not statically imported -------
  // NEVER delete one of these to satisfy knip: each is load-bearing through a
  // mechanism knip cannot see.
  "ignoreDependencies": [
    // Kept for version alignment with the Rust `tauri-plugin-store` — see
    // docs/dependencies.md → Frontend: "(MCP) store bindings … the package keeps
    // the plugin versions aligned". The popover reads settings via commands.
    "@tauri-apps/plugin-store",
    // Required at runtime by `@wdio/cli` (`runner: "local"`); resolved dynamically.
    "@wdio/local-runner",
  ],

  "ignoreBinaries": [
    // ImageMagick, invoked via `execFileSync("magick", …)` to crop screenshot
    // captures (e2e/screenshots/capture.spec.ts). An OS-level prerequisite, not an
    // npm package, so it is not an "unlisted dependency".
    "magick",
  ],

  // --- Dead-code worklist (now emptied) ----------------------------------------
  // Phase 1 pinned the genuinely-unused exports/types here so `npx knip` could be
  // an exit-0 gate; phase 3 (dead-code removal) has now deleted each one.
  "ignoreIssues": {},
}
