---
import { FEATURE_ICONS, type FeatureIconName } from "../lib/feature-icons";

interface Props {
  name: FeatureIconName;
}

const { name } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={FEATURE_ICONS[name]}
></svg>
