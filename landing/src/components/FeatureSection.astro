---
import FeatureIcon from "./FeatureIcon.astro";
import type { FeatureIconName } from "../lib/feature-icons";

interface Props {
  id: string;
  label: string;
  icon: FeatureIconName;
  title: string;
  reverse?: boolean;
}

const { id, label, icon, title, reverse = false } = Astro.props;
---

<section
  class:list={["feature", { "feature--reverse": reverse }]}
  id={id}
  aria-labelledby={`${id}-title`}
>
  <div class="feature-copy">
    <p class="feature-kicker">
      <span class="feature-kicker__icon"><FeatureIcon name={icon} /></span>
      <span>{label}</span>
    </p>
    <h2 id={`${id}-title`}>{title}</h2>
    <slot />
  </div>

  <div class="feature-media">
    <slot name="media" />
  </div>

  {
    Astro.slots.has("below") && (
      <div class="feature-below">
        <slot name="below" />
      </div>
    )
  }
</section>
