---
import AnalysisTabs from "../components/AnalysisTabs.tsx";
import CopyButton from "../components/CopyButton.tsx";
import FeatureIcon from "../components/FeatureIcon.astro";
import FeatureSection from "../components/FeatureSection.astro";
import HeroVideo from "../components/HeroVideo.tsx";
import ImageDeck from "../components/ImageDeck.tsx";
import BaseLayout from "../layouts/BaseLayout.astro";
import { analysisTabs, exportCards, sourceCards } from "../lib/feature-content";
import { readPackageVersion } from "../lib/repo";
import { link, REPO } from "../lib/site";

const version = readPackageVersion();
const releaseUrl = `${REPO}/releases/latest`;

const cliSnippet = `hey-listen-cli analyze call.flac --tool tempo --json`;
const mcpSnippet = `{
  "mcpServers": {
    "hey-listen": { "command": "heylisten-mcp" }
  }
}`;
const tree = `hey-listen/
  src/         SolidJS frontend
  src-tauri/   Rust core, CLI, and MCP
  docs/        manual and design notes
  landing/     this page`;
---

<BaseLayout
  title="Hey Listen — an audio analysis workbench"
  description="A free, public-domain audio analysis workbench for files, live inputs, and synthesis. Filter it, measure it, save the project."
>
  <section class="hero" id="home">
    <div class="hero-film-wrap">
      <HeroVideo
        client:load
        src={link("media/hero.mp4")}
        poster={link("manual-assets/001-shell.png")}
        alt="A short tour of the Hey Listen workbench: the timeline, a filter graph, a spectrum, annotations, a comparison, and the export rail."
      />
    </div>

    <div class="container hero-copy">
      <p class="eyebrow">Audio analysis workbench</p>
      <h1>Hear more.<br /><span>Spend less time searching.</span></h1>
      <p class="hero-lede">
        Let an agent find the interesting moments. Open the same project to listen,
        inspect the measurements, and decide what they mean. Or start at the waveform
        and work by hand.
      </p>
      <div class="hero-actions">
        <a class="button" href="#download">Download Hey Listen</a>
        <a class="button button--ghost" href={link("docs/")}>Read the manual</a>
      </div>
      <p class="hero-meta">Free and public domain. macOS, Windows, and Linux.</p>
    </div>
  </section>

  <section class="brief container" aria-labelledby="brief-title">
    <h2 id="brief-title" class="sr-only">What Hey Listen does</h2>
    <p class="brief-lede">
      Hey Listen keeps one source, its graphs, and the views you open in one project.
      Open a file, capture a live input, or synthesize a sound. Narrow the analysis
      window, then look at it with the tools you need. The app measures; you decide
      what the numbers mean.
    </p>

    <div class="notes">
      <article class="note">
        <span class="note__icon" aria-hidden="true"><FeatureIcon name="development" /></span>
        <div>
          <h3>In active development</h3>
          <p>
            Features and file formats can still change between releases. If a number
            matters, check it against the window, the settings, and a second
            measurement.
          </p>
        </div>
      </article>
      <article class="note">
        <span class="note__icon" aria-hidden="true"><FeatureIcon name="ai" /></span>
        <div>
          <h3>Built with AI agents</h3>
          <p>
            AI coding agents contributed to the code and the documentation. Read and
            test what you rely on, including this page.
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="features" id="features" aria-labelledby="features-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Features</p>
        <h2 id="features-title">One source. Several ways to know it.</h2>
        <p>
          Each section below links to the chapter of the manual that covers it. The
          manual is part of this site, and it is built from the same repository as the
          app.
        </p>
      </header>

      <FeatureSection
        id="sources"
        label="01 — Sources"
        icon="source"
        title="Start with the sound you have."
      >
        <p>
          Open an audio file, record a microphone, system output, one process, or a
          mic-and-system mix. Or build a Synth graph and render it into the timeline.
          A project has exactly one source, and replacing it replaces the timeline.
        </p>
        <ul class="points">
          <li>Files, live capture, and fundsp synthesis.</li>
          <li>Embedded, linked, or live-linked storage for a file source.</li>
          <li>Recording controls stay in the Sources rail while a capture runs.</li>
        </ul>
        <p><a class="text-link" href={link("docs/002-sources/")}>Open, record, or synthesize a source →</a></p>

        <ImageDeck client:visible slot="media" cards={sourceCards} label="Choose a source" />
      </FeatureSection>

      <FeatureSection
        id="analysis"
        label="02 — Analysis"
        icon="analysis"
        title="Open a tool. Read the chart. Check the caveat."
      >
        <p>
          Pick a section — Time, Spectral, Pitch, Rhythm, Loudness, or Perception — and
          open a tool. It becomes a Workbench tab, and opening it again focuses the same
          tab. Shared FFT, window, channel, and frequency settings keep two charts
          describing the same thing. Every tool has an About panel that says what it
          measures.
        </p>
        <ul class="points">
          <li>Readouts, charts, and tables from the same analysis window.</li>
          <li>Charts share a playhead, so previewing moves every view together.</li>
          <li>A slow run keeps its tab, shows progress, and can be cancelled.</li>
        </ul>
        <p><a class="text-link" href={link("docs/005-analyzers/")}>Measure what the window contains →</a></p>

        <figure slot="media" class="shot-frame">
          <img
            src={link("images/analysis-workbench.png")}
            alt="The whole workbench: the Spectral tool list in the sidebar, the Spectrogram tab and its chart, and the timeline below."
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            The section's tools, the open analyzer, and the timeline live in one
            window.
          </figcaption>
        </figure>

        <AnalysisTabs client:visible slot="below" tabs={analysisTabs} />
      </FeatureSection>

      <FeatureSection
        id="graphs"
        label="03 — Filter & Synth"
        icon="graph"
        title="Shape it before you measure it."
        reverse
      >
        <p>
          The Filter graph runs upstream of playback and every analyzer, so you hear
          and measure the same signal. The Synth graph renders fundsp synthesis into
          the timeline. Both editors accept DOT text, so a graph can live in a script,
          an issue, or an agent's message.
        </p>
        <ul class="points">
          <li>Filter and Synth are Workbench tabs, beside the analyzers.</li>
          <li>DOT is the canonical graph form across the app, MCP, and the CLI.</li>
          <li>The node catalog includes nested subsystems and live taps.</li>
        </ul>
        <p><a class="text-link" href={link("docs/004-graphs/")}>Shape the sound →</a></p>

        <figure slot="media" class="shot-frame">
          <img
            src={link("manual-assets/004-filter.png")}
            alt="The filter graph editor with connected fundsp nodes."
            loading="lazy"
            decoding="async"
          />
          <figcaption>The Filter graph. The same graph is available as DOT text.</figcaption>
        </figure>
      </FeatureSection>

      <FeatureSection
        id="agents"
        label="04 — MCP & CLI"
        icon="terminal"
        title="Drive it from an agent, or from a shell."
      >
        <p>
          Enable the MCP server and an agent can open sources, change settings, run
          analyses, preview, annotate, compare, export, and save on the window you are
          watching. The same analysis engine runs headless in
          <code>hey-listen-cli</code>.
        </p>
        <ul class="points">
          <li>The live window follows the agent's calls.</li>
          <li>Ask for a summary, a compact preview, or the full arrays.</li>
          <li>A one-off run can skip opening a tab or changing your setup.</li>
        </ul>
        <p><a class="text-link" href={link("docs/")}>The manual's agent and command-line sections →</a></p>

        <div slot="media" class="code-stack">
          <div class="code-card">
            <div class="code-card__bar">
              <span>Shell</span>
              <CopyButton client:visible text={cliSnippet} />
            </div>
            <pre><code>{cliSnippet}</code></pre>
          </div>
          <div class="code-card">
            <div class="code-card__bar">
              <span>MCP</span>
              <CopyButton client:visible text={mcpSnippet} />
            </div>
            <pre><code>{mcpSnippet}</code></pre>
          </div>
          <p class="code-note">
            Copy the exact snippet from the app's MCP control. The command path depends
            on your install.
          </p>
        </div>
      </FeatureSection>

      <FeatureSection
        id="export"
        label="05 — Import & export"
        icon="export"
        title="Take the data with you."
        reverse
      >
        <p>
          Export the analysis window as WAV, FLAC, or AIFF, with the depth and channel
          layout you need. Save a tool's result as provenance JSON or a wide CSV with a
          sidecar, and a chart as PNG. The <code>.heyl</code> project keeps the source,
          graphs, setup, and results together.
        </p>
        <ul class="points">
          <li>Audio export can apply the filter independently of the toolbar switch.</li>
          <li>CSV rows carry their units and provenance in a sidecar file.</li>
          <li>A chart PNG matches the active theme and the zoom you set.</li>
        </ul>
        <p><a class="text-link" href={link("docs/009-projects/")}>Keep, undo, and take the data out →</a></p>

        <div slot="media">
          <ImageDeck
            client:visible
            cards={exportCards}
            variant="panel"
            label="Choose an export"
          />
        </div>
      </FeatureSection>

      <FeatureSection
        id="open"
        label="06 — Open source"
        icon="open"
        title="Public domain, not a demo."
      >
        <p>
          Hey Listen is released under the Unlicense. You can read the source, fork it,
          and ship your own build. There is no account and no paid tier.
        </p>
        <ul class="points">
          <li>The app, the core, the CLI, and this landing live in one repository.</li>
          <li>Issues and feature proposals are welcome.</li>
          <li>The manual is part of the repository and this site.</li>
        </ul>
        <p>
          <a class="text-link" href={REPO} target="_blank" rel="noopener">
            Read the repository on GitHub →
          </a>
        </p>

        <div slot="media" class="code-card code-card--tree">
          <div class="code-card__bar">
            <span>Repository</span>
          </div>
          <pre><code>{tree}</code></pre>
        </div>
      </FeatureSection>
    </div>
  </section>

  <section class="download" id="download" aria-labelledby="download-title">
    <div class="container download-inner">
      <p class="eyebrow">Download</p>
      <h2 id="download-title">Take it for a listen.</h2>
      <p class="download-lede">
        One public-domain build for macOS, Windows, and Linux. The latest release page
        lists the installers and what changed.
      </p>
      <div class="download-actions">
        <a class="button button--large" href={releaseUrl}>
          Download Hey Listen
          <span class="button-version">v{version}</span>
        </a>
        <a class="button button--ghost" href={link("docs/")}>Read the manual</a>
      </div>
      <ul class="download-facts">
        <li>Free and public domain</li>
        <li>macOS, Windows, and Linux</li>
        <li>Release notes on GitHub</li>
      </ul>
      <p class="download-note">
        No account, no paid tier. If the latest release does not start, open an issue
        with the version and your platform.
      </p>
    </div>
  </section>
</BaseLayout>
