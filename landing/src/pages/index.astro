---
import AnalysisTabs from "../components/AnalysisTabs.tsx";
import CopyButton from "../components/CopyButton.tsx";
import FeatureIcon from "../components/FeatureIcon.astro";
import FeatureSection from "../components/FeatureSection.astro";
import HeroVideo from "../components/HeroVideo.tsx";
import ImageDeck from "../components/ImageDeck.tsx";
import BaseLayout from "../layouts/BaseLayout.astro";
import { analysisTabs, exportCards, sourceCards } from "../lib/feature-content";
import { readPackageVersion } from "../lib/repo";
import { link, REPO } from "../lib/site";

const version = readPackageVersion();
const releaseUrl = `${REPO}/releases/latest`;

const cliSnippet = `hey-listen-cli analyze call.flac --tool tempo --json`;
const mcpSnippet = `{
  "mcpServers": {
    "hey-listen": { "command": "heylisten-mcp" }
  }
}`;
const tree = `hey-listen/
  src/         SolidJS frontend
  src-tauri/   Rust core, CLI, and MCP
  docs/        manual and design notes
  landing/     this page`;
---

<BaseLayout
  title="Hey Listen — an audio analysis workbench"
  description="A free, public-domain audio analysis workbench for files, live inputs, and synthesis. Filter it, measure it, save the project."
>
  <section class="hero" id="home">
    <div class="hero-film-wrap">
      <HeroVideo
        client:load
        videoId="lOKQdIMHQlI"
        poster={link("manual-assets/001-shell.png")}
        alt="A short tour of the Hey Listen workbench: the timeline, a filter graph, a spectrum, annotations, a comparison, and the export rail."
      />
      <p class="hero-film-credit">
        Music: {" "}
        <a
          href="https://commons.wikimedia.org/wiki/File:Grieg_Holberg_Suite_1_Praeludium.ogg"
          target="_blank"
          rel="noopener"
        >
          Edvard Grieg, Holberg Suite, Praeludium
        </a>{" "}
        (<a href="https://creativecommons.org/licenses/by-sa/3.0" target="_blank" rel="noopener">
          CC BY-SA 3.0
        </a>)
      </p>
    </div>

    <div class="container hero-copy">
      <p class="eyebrow">Audio analysis workbench</p>
      <h1>Hear more.<br /><span>Spend less time searching.</span></h1>
      <p class="hero-lede">
        Ask an agent to surface the interesting moments, then listen and judge them
        yourself. Or start at the waveform and explore by hand.
      </p>
      <div class="hero-actions">
        <a class="button" href="#download">Download Hey Listen</a>
        <a class="button button--ghost" href={link("docs/")}>Read the manual</a>
      </div>
      <p class="hero-meta">Free and public domain. macOS, Windows, and Linux.</p>
    </div>
  </section>

  <section class="brief container" aria-labelledby="brief-title">
    <h2 id="brief-title" class="sr-only">What Hey Listen does</h2>
    <p class="brief-lede">
      One project holds the source, the graphs, and the views you open. Narrow the
      window, open a tool, and decide what the numbers mean.
    </p>

    <div class="notes">
      <article class="note">
        <span class="note__icon" aria-hidden="true"><FeatureIcon name="development" /></span>
        <div>
          <h3>In active development</h3>
          <p>
            Features and file formats can still change. If a number matters, check it
            against the window and the settings.
          </p>
        </div>
      </article>
      <article class="note">
        <span class="note__icon" aria-hidden="true"><FeatureIcon name="ai" /></span>
        <div>
          <h3>Built with AI agents</h3>
          <p>
            AI coding agents helped write the code and the documentation. Read and test
            what you rely on.
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="features" id="features" aria-labelledby="features-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Features</p>
        <h2 id="features-title">One source. Several ways to know it.</h2>
        <p>Each section links to the chapter of the manual that covers it.</p>
      </header>

      <FeatureSection
        id="sources"
        label="01 — Sources"
        icon="source"
        title="Start with the sound you have."
      >
        <p>
          Open a file, record a microphone, system output, one app, or a mix. Or build
          a Synth graph and render it into the timeline.
        </p>
        <ul class="points">
          <li>Files, live capture, and synthesis.</li>
          <li>Embedded, linked, or live-linked storage.</li>
          <li>Recording controls stay while a capture runs.</li>
        </ul>
        <p><a class="text-link" href={link("docs/002-sources/")}>Open, record, or synthesize a source →</a></p>

        <ImageDeck client:visible slot="media" cards={sourceCards} label="Choose a source" />
      </FeatureSection>

      <FeatureSection
        id="analysis"
        label="02 — Analysis"
        icon="analysis"
        title="See what you're hearing."
      >
        <p>
          Pick a section — Time, Spectral, Pitch, Rhythm, Loudness, or Perception — and
          open a tool. Shared settings keep your charts describing the same thing, and
          each tool's About panel says what it measures.
        </p>
        <ul class="points">
          <li>Readouts, charts, and tables from the same window.</li>
          <li>Charts share a playhead, so preview moves every view together.</li>
          <li>A slow run keeps its tab and can be cancelled.</li>
        </ul>
        <p><a class="text-link" href={link("docs/005-analyzers/")}>Measure what the window contains →</a></p>

        <figure slot="media" class="shot-frame">
          <img
            src={link("images/analysis-workbench.png")}
            alt="The whole workbench: the Spectral tool list in the sidebar, the Spectrogram tab and its chart, and the timeline below."
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            The section's tools, the open analyzer, and the timeline live in one
            window.
          </figcaption>
        </figure>

        <AnalysisTabs client:visible slot="below" tabs={analysisTabs} />
      </FeatureSection>

      <FeatureSection
        id="graphs"
        label="03 — Filter & Synth"
        icon="graph"
        title="Shape it before you measure it."
        reverse
      >
        <p>
          The Filter graph runs before playback and every analyzer, so you hear and
          measure the same signal. The Synth graph renders sound into the timeline.
          Both accept DOT text, so a graph can live in a script or a message.
        </p>
        <ul class="points">
          <li>Filter and Synth sit beside the analyzers.</li>
          <li>DOT is the same graph form everywhere.</li>
          <li>The node catalog includes subsystems and live taps.</li>
        </ul>
        <p><a class="text-link" href={link("docs/004-graphs/")}>Shape the sound →</a></p>

        <figure slot="media" class="shot-frame">
          <img
            src={link("manual-assets/004-filter.png")}
            alt="The filter graph editor with connected fundsp nodes."
            loading="lazy"
            decoding="async"
          />
          <figcaption>The Filter graph. The same graph is available as DOT text.</figcaption>
        </figure>
      </FeatureSection>

      <FeatureSection
        id="agents"
        label="04 — MCP & CLI"
        icon="terminal"
        title="Drive it from an agent, or from a shell."
      >
        <p>
          Turn on the MCP server and an agent can open sources, run analyses, preview,
          annotate, compare, and export on the window you're watching. The same engine
          runs headless in <code>hey-listen-cli</code>.
        </p>
        <ul class="points">
          <li>The window follows the agent's calls.</li>
          <li>Ask for a summary, a preview, or the full data.</li>
          <li>A one-off run can skip touching your setup.</li>
        </ul>
        <p><a class="text-link" href={link("docs/")}>The manual's agent and command-line sections →</a></p>

        <div slot="media" class="code-stack">
          <div class="code-card">
            <div class="code-card__bar">
              <span>Shell</span>
              <CopyButton client:visible text={cliSnippet} />
            </div>
            <pre><code>{cliSnippet}</code></pre>
          </div>
          <div class="code-card">
            <div class="code-card__bar">
              <span>MCP</span>
              <CopyButton client:visible text={mcpSnippet} />
            </div>
            <pre><code>{mcpSnippet}</code></pre>
          </div>
          <p class="code-note">
            Copy the exact snippet from the app's MCP control. The command path depends
            on your install.
          </p>
        </div>
      </FeatureSection>

      <FeatureSection
        id="export"
        label="05 — Import & export"
        icon="export"
        title="Take the data with you."
        reverse
      >
        <p>
          Export the window as WAV, FLAC, or AIFF. Save a result as JSON or CSV, and a
          chart as PNG. The <code>.heyl</code> project keeps source, graphs, setup, and
          results together.
        </p>
        <ul class="points">
          <li>Audio export can apply the filter.</li>
          <li>CSV keeps its units and provenance.</li>
          <li>A chart PNG matches your theme and zoom.</li>
        </ul>
        <p><a class="text-link" href={link("docs/009-projects/")}>Keep, undo, and take the data out →</a></p>

        <div slot="media">
          <ImageDeck
            client:visible
            cards={exportCards}
            variant="panel"
            label="Choose an export"
          />
        </div>
      </FeatureSection>

      <FeatureSection
        id="open"
        label="06 — Open source"
        icon="open"
        title="Public domain, not a demo."
      >
        <p>
          Hey Listen is released under the Unlicense. Read the source, fork it, or ship
          your own build.
        </p>
        <ul class="points">
          <li>App, core, CLI, and this site live in one repository.</li>
          <li>Issues and feature proposals are welcome.</li>
          <li>The manual is part of the repository.</li>
        </ul>
        <p>
          <a class="text-link" href={REPO} target="_blank" rel="noopener">
            Read the repository on GitHub →
          </a>
        </p>

        <div slot="media" class="code-card code-card--tree">
          <div class="code-card__bar">
            <span>Repository</span>
          </div>
          <pre><code>{tree}</code></pre>
        </div>
      </FeatureSection>
    </div>
  </section>

  <section class="download" id="download" aria-labelledby="download-title">
    <div class="container download-inner">
      <p class="eyebrow">Download</p>
      <h2 id="download-title">Take it for a listen.</h2>
      <p class="download-lede">
        One public-domain build for macOS, Windows, and Linux. The latest release lists
        the installers.
      </p>
      <div class="download-actions">
        <a class="button button--large" href={releaseUrl}>
          Download Hey Listen
          <span class="button-version">v{version}</span>
        </a>
        <a class="button button--ghost" href={link("docs/")}>Read the manual</a>
      </div>
      <ul class="download-facts">
        <li>Free and public domain</li>
        <li>No account, no sign-up</li>
        <li>Installers on GitHub</li>
      </ul>
      <p class="download-note">
        If it doesn't start, open an issue with your version and platform.
      </p>
    </div>
  </section>
</BaseLayout>
