---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ISSUES, link, REPO } from "../lib/site";
---

<BaseLayout
  title="Sponsor — Hey Listen"
  description="Sponsorship is not open yet. Here is what helps in the meantime."
>
  <section class="page-hero container">
    <p class="eyebrow">Sponsor</p>
    <h1>Sponsorship is not open yet.</h1>
    <p>
      This page is a placeholder. Hey Listen is free and public domain, with no paid
      tier and no support contract. When a sponsorship route exists, it will be listed
      here.
    </p>
  </section>

  <section class="container">
    <div class="sponsor-card">
      <h2>What helps in the meantime</h2>
      <ul class="points">
        <li>A clear bug report with the version and your platform.</li>
        <li>A correction to the manual, especially one with a screenshot.</li>
        <li>A feature proposal with the problem it solves.</li>
      </ul>
      <div class="roadmap-cta__actions">
        <a class="button" href={ISSUES} target="_blank" rel="noopener">Open an issue</a>
        <a class="button button--ghost" href={REPO} target="_blank" rel="noopener">
          Read the repository
        </a>
      </div>
      <p class="sponsor-card__note">
        No payment details are collected on this page. If you want to be told when
        sponsorship opens, watch the repository.
      </p>
    </div>
  </section>

  <p class="container page-back">
    <a class="text-link" href={link("")}>← Back to the landing</a>
  </p>
</BaseLayout>
