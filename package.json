{
  "name": "hey-listen",
  "version": "0.2.0",
  "description": "Hey Listen — audio analysis workbench: capture, filter, and analyze audio from files, inputs, and synthesis.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve:site": "node scripts/serveSite.mjs",
    "build:site": "node scripts/buildSite.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "test:unit": "tsx scripts/themeFile.test.ts && tsx scripts/notes.test.ts",
    "tauri": "tauri",
    "test:e2e": "wdio run wdio.conf.ts",
    "test:e2e:build": "npm run tauri build && npm run test:e2e",
    "screenshots": "wdio run screenshots.wdio.conf.ts",
    "prepare": "husky",
    "maid": "npm run maid:fmt && npm run maid:lint && npm run maid:size && npm run maid:dup && npm run maid:dead && npm run maid:rs",
    "maid:fmt": "prettier --check .",
    "maid:lint": "eslint .",
    "maid:size": "node scripts/checkFileSize.mjs",
    "maid:dup": "jscpd .",
    "maid:dead": "knip",
    "maid:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "maid:fix": "prettier --write . && eslint . --fix && node scripts/checkFileSize.mjs --update && cargo fmt --manifest-path src-tauri/Cargo.toml"
  },
  "license": "Unlicense",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@dschz/solid-flow": "^0.2.6",
    "@dschz/solid-uplot": "^0.5.2",
    "@kobalte/core": "^0.13.14",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.2",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-store": "^2.5.0",
    "dockview": "^8.5.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "solid-js": "^1.9.17",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@wdio/cli": "^10.0.2",
    "@wdio/globals": "^10.0.2",
    "@wdio/json-reporter": "^10.0.1",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "@wdio/tauri-plugin": "^1.5.0",
    "@wdio/tauri-service": "^1.5.0",
    "@wdio/types": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14"
  }
}
