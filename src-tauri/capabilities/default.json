{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the project windows (the main window, any window opened via New Window, and a tab or note popped out of one)",
  "windows": ["main", "project-*", "popout-*", "note-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "log:default",
    "clipboard-manager:allow-write-text",
    "wdio:default",
    "wdio-webdriver:default"
  ]
}
