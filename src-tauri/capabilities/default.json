{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the project windows (the main window and any window opened via New Window)",
  "windows": ["main", "project-*", "popout-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "log:default",
    "clipboard-manager:allow-write-text",
    "wdio:default",
    "wdio-webdriver:default"
  ]
}
