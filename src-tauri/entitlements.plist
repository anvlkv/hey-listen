<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime gates microphone capture on this entitlement; without it TCC
       denies the request without ever showing the consent prompt. System/process
       audio (kTCCServiceAudioCapture) does not need it. See docs/source-model.md. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
