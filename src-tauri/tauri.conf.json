{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hey Listen",
  "mainBinaryName": "hey-listen",
  "version": "0.1.0",
  "identifier": "com.anvlkv.heylisten",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Hey Listen",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Audio analysis workbench: capture, filter, and analyze audio.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["heyl"],
        "name": "Hey Listen Project",
        "description": "Hey Listen audio analysis project",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-hey-listen-project",
        "exportedType": {
          "identifier": "com.anvlkv.heylisten.project",
          "conformsTo": ["public.data"]
        }
      }
    ]
  }
}
