{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // `scripts/` holds the repo's Node-side build helpers (`tsx` runs them without
  // type-checking) — so they are checked here, or their types drift silently. The
  // browser-free unit suites live under `src/tests/` and are covered by `src`.
  "include": ["src", "scripts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
